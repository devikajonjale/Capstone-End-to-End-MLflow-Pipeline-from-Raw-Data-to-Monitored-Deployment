{
  "annotations": {"list": []},
  "editable": true,
  "schemaVersion": 39,
  "title": "House Price API",
  "tags": ["mlops", "serving"],
  "time": {"from": "now-15m", "to": "now"},
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests per second",
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum(rate(prediction_requests_total[1m]))", "legendFormat": "req/s",
         "datasource": {"type": "prometheus", "uid": "prometheus"}}
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Errors per second",
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 0},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"},
        "thresholds": {"steps": [
          {"color": "green", "value": null}, {"color": "red", "value": 0.01}]}}},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum(rate(prediction_errors_total[1m]))", "legendFormat": "err/s",
         "datasource": {"type": "prometheus", "uid": "prometheus"}}
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total predictions served",
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum(prediction_requests_total)", "legendFormat": "total",
         "datasource": {"type": "prometheus", "uid": "prometheus"}}
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Prediction latency (p50 / p95)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(prediction_latency_seconds_bucket[5m])) by (le))",
         "legendFormat": "p50", "datasource": {"type": "prometheus", "uid": "prometheus"}},
        {"expr": "histogram_quantile(0.95, sum(rate(prediction_latency_seconds_bucket[5m])) by (le))",
         "legendFormat": "p95", "datasource": {"type": "prometheus", "uid": "prometheus"}}
      ]
    },
    {
      "id": 5,
      "type": "barchart",
      "title": "Predicted price distribution (lakhs)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum by (le) (predicted_price_lakhs_bucket)", "legendFormat": "<= {{le}}",
         "format": "heatmap", "datasource": {"type": "prometheus", "uid": "prometheus"}}
      ]
    }
  ]
}
